{
  "manifest_version": 3,
  "minimum_chrome_version": "138",
  "name": "GitHub Translate",
  "version": "0.1.0",
  "description": "Translate GitHub issue/PR content and READMEs with Chrome's built-in Translator API",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Translate"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
